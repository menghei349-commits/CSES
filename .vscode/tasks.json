{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++17 build (WSL)",
            "type": "process",
            "command": "wsl",
            "args": [
                "--cd", "${fileDirname}",
                "g++", "-std=c++17", "-O2", "-Wall", "-Wextra", "-g",
                "${fileBasename}", "-o", "${fileBasenameNoExtension}"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "C++17 build & run (WSL)",
            "type": "process",
            "command": "wsl",
            "args": [
                "--cd", "${fileDirname}",
                "bash", "-c",
                "g++ -std=c++17 -O2 -Wall -Wextra -g '${fileBasename}' -o '${fileBasenameNoExtension}' && './${fileBasenameNoExtension}'"
            ],
            "group": { "kind": "test", "isDefault": true },
            "presentation": { "reveal": "always", "focus": true, "clear": true, "panel": "shared" },
            "problemMatcher": ["$gcc"]
        }
    ]
}
